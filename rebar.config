%% Erlang compilation options
{erl_opts, [debug_info]}.

%% No external dependencies
{deps, []}.

%% Project app directories
{project_app_dirs, ["src"]}.

%% Leex (scanner) - rebar3 handles .xrl files automatically
{xrl_opts, []}.

%% Yecc (parser) - rebar3 handles .yrl files automatically
{yrl_opts, []}.

%% eunit test options
{eunit_opts, [verbose]}.

%% Post-compile hook for Reia (.re) file compilation
{post_hooks, [
  {compile, "escript priv/reia_compile.escript"}
]}.

%% Build the reia escript executable
{escript_incl_apps, [reia]}.
{escript_emu_args, "+K true"}.
{escript_name, "reia"}.
{escript_shebang, "#!/usr/bin/env escript"}.

%% REPL shell configuration
{shell, [
  {apps, [reia]}
]}.
