%% Erlang compilation options
{erl_opts, [debug_info]}.

%% No external dependencies
{deps, []}.

%% Project app directories
{project_app_dirs, ["src"]}.

%% Leex (scanner) - rebar3 handles .xrl files automatically
{xrl_opts, []}.

%% Yecc (parser) - rebar3 handles .yrl files automatically
{yrl_opts, []}.

%% eunit test options
{eunit_opts, [verbose]}.

%% Post-compile hook for Reia (.re) file compilation
{post_hooks, [
  {compile, "escript bin/reia_compile.escript"}
]}.

%% REPL shell configuration
{shell, [
  {apps, []}
]}.
