#!/bin/sh

USAGE="Usage: `basename $0` file.re"

if [ $# -eq 0 ]; then
	echo $USAGE >&2
	exit 1
fi

# Get the absolute directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# REIA_HOME is the parent directory of bin/
REIA_HOME="$(dirname "$SCRIPT_DIR")"

PROGRAM=$1
shift

export REIA_HOME
EXTRA_PATHS="-pz $REIA_HOME/ebin -pz $REIA_HOME/../ebin"
erl $EXTRA_PATHS -noshell +K true -s reia init -s reia_internal execute_file "$PROGRAM" -s init stop -extra "$@"